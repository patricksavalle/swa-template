{
  "scriptFile": "../dist/resources/index.js",
  "entryPoint": "resources",
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "request",
      "methods": ["get"],
      "route": "resources"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "$return"
    }
  ]
}
